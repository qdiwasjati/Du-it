# DUIT! mobile - konfigurasi layanan peta & backend.
# Salin ke .env lalu isi. Semua nilai dibaca saat build/bundle (prefix EXPO_PUBLIC_).
#
# Karena app jalan di HP, JANGAN pakai localhost. Pakai IP LAN PC yang menjalankan
# doit-maps-server (Windows: `ipconfig` -> IPv4 Address Wi-Fi). HP & PC harus satu Wi-Fi.
# Port di bawah = default doit-maps-server; sesuaikan dengan .env di server.

# Style MapLibre (JSON) yang menunjuk ke tile PMTiles lokal
EXPO_PUBLIC_MAP_STYLE_URL=http://192.168.1.X:8004/style.json

# Photon (geocoding / pencarian alamat)
EXPO_PUBLIC_GEOCODER_URL=http://192.168.1.X:8003

# Valhalla (routing, ETA, map matching)
EXPO_PUBLIC_ROUTING_URL=http://192.168.1.X:8002

# Supabase (Settings -> API). Hanya publishable/anon key; JANGAN pernah taruh service_role di sini.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
